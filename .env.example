# Copy this file to .env for local development (.env is not committed).
# For the GitHub Pages deploy, set the same three names as repository Variables:
# GitHub -> Settings -> Secrets and variables -> Actions -> Variables.

# Discord application's OAuth2 Client ID (Discord Developer Portal -> OAuth2)
VITE_DISCORD_CLIENT_ID=

# Supabase project (Dashboard -> Project Settings -> API). The anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
